RewriteEngine On
RewriteBase /syntrelink/

RewriteRule ^s/auth/login/?$ login.php [L,QSA]
RewriteRule ^s/auth/forgot-password/?$ forgot_password.php?role=student [L,QSA]
RewriteRule ^s/dashboard/?$ student/dashboard.php [L,QSA]
RewriteRule ^s/my-qr/?$ student/my_qr.php [L,QSA]
RewriteRule ^s/my-tickets/?$ student/my_ticket.php [L,QSA]
RewriteRule ^s/profile/?$ student/profile.php [L,QSA]
RewriteRule ^s/settings/?$ student/settings.php [L,QSA]
RewriteRule ^s/settings/email-setup/?$ student/email_setup.php [L,QSA]
RewriteRule ^s/settings/reset-password/?$ student/reset_password.php [L,QSA]
RewriteRule ^s/notifications/?$ student/notifications.php [L,QSA]
RewriteRule ^s/auth/logout/?$ logout.php [L,QSA]

RewriteRule ^o/auth/login/?$ officers/loginofficers.php [L,QSA]
RewriteRule ^o/auth/forgot-password/?$ forgot_password.php?role=ssg [L,QSA]
RewriteRule ^o/dashboard/?$ officers/dashboard.php [L,QSA]
RewriteRule ^o/scanner/?$ officers/scanner.php [L,QSA]
RewriteRule ^o/gate-log/?$ officers/gate_log.php [L,QSA]
RewriteRule ^o/gate-log/lookup/?$ officers/manual_lookup.php [L,QSA]
RewriteRule ^o/auth/logout/?$ logout.php [L,QSA]

RewriteRule ^admin/auth/login/?$ loginadmin.php [L,QSA]
RewriteRule ^admin/auth/forgot-password/?$ forgot_password.php?role=admin [L,QSA]
RewriteRule ^admin/dashboard/?$ admin/dashboard.php [L,QSA]
RewriteRule ^admin/events/?$ admin/events.php [L,QSA]
RewriteRule ^admin/events/create/?$ admin/events.php?action=create [L,QSA]
RewriteRule ^admin/events/([0-9]+)/edit/?$ admin/events.php?action=edit&id=$1 [L,QSA]
RewriteRule ^admin/events/([0-9]+)/activities/?$ admin/activities.php?event_id=$1 [L,QSA]
RewriteRule ^admin/events/([0-9]+)/gate-prepare/?$ admin/events.php?action=prepare&id=$1 [L,QSA]
RewriteRule ^admin/students/?$ admin/students.php [L,QSA]
RewriteRule ^admin/students/import/?$ admin/students.php?action=import [L,QSA]
RewriteRule ^admin/tickets/?$ admin/tickets.php [L,QSA]
RewriteRule ^admin/tickets/import-receipts/?$ admin/import_receipts.php [L,QSA]
RewriteRule ^admin/tickets/import-receipts/confirm/?$ admin/import_confirm.php [L,QSA]
RewriteRule ^admin/tickets/import-receipts/success/?$ admin/import_success.php [L,QSA]
RewriteRule ^admin/admissions/?$ admin/admissions.php [L,QSA]
RewriteRule ^admin/notifications/broadcast/?$ admin/broadcast.php [L,QSA]
RewriteRule ^admin/reports/?$ admin/reports.php [L,QSA]
RewriteRule ^admin/audit-logs/?$ admin/audit_logs.php [L,QSA]
RewriteRule ^admin/settings/?$ admin/settings.php [L,QSA]
RewriteRule ^admin/admins/?$ admin/admins.php [L,QSA]
RewriteRule ^admin/auth/logout/?$ logout.php [L,QSA]

RewriteRule ^director/auth/login/?$ loginadmin.php?director=1 [L,QSA]
RewriteRule ^director/auth/forgot-password/?$ forgot_password.php?role=director [L,QSA]
RewriteRule ^director/dashboard/?$ director/dashboard.php [L,QSA]
RewriteRule ^director/events/?$ director/events.php [L,QSA]
RewriteRule ^director/admissions/?$ director/admissions.php [L,QSA]
RewriteRule ^director/reports/?$ director/reports.php [L,QSA]
RewriteRule ^director/audit-logs/?$ director/audit_logs.php [L,QSA]
RewriteRule ^director/auth/logout/?$ logout.php [L,QSA]

RewriteRule ^api/qr/generate/?$ api/qr_generate.php [L,QSA]
RewriteRule ^api/qr/validate/?$ api/qr_validate.php [L,QSA]
RewriteRule ^api/gate-log/([0-9]+)/?$ api/gate_log.php?event_id=$1 [L,QSA]
RewriteRule ^api/notifications/?$ api/notifications.php [L,QSA]
RewriteRule ^api/notifications/read/?$ api/notifications_read.php [L,QSA]
RewriteRule ^api/events/([0-9]+)/attendee-cache/?$ api/attendee_cache.php?event_id=$1 [L,QSA]
